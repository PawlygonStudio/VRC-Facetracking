/* Pawlygon face tracking inspectors. Colors match Pawlygon Unity Tools (PawlygonEditorUI). */

.ft-dark {
    --ft-text: rgb(210, 210, 210);
    --ft-ok: rgb(107, 204, 120);
    --ft-ok-bg: rgba(107, 204, 120, 0.16);
    --ft-warning: rgb(255, 184, 77);
    --ft-warning-bg: rgba(255, 184, 77, 0.13);
    --ft-error: rgb(255, 115, 107);
    --ft-error-bg: rgba(255, 115, 107, 0.14);
    --ft-info: rgb(115, 179, 255);
    --ft-info-bg: rgba(115, 179, 255, 0.13);
    --ft-muted: rgb(153, 153, 153);
    --ft-muted-bg: rgba(255, 255, 255, 0.06);
    --ft-primary: rgb(0, 78, 149);
    --ft-primary-hover: rgb(0, 96, 176);
    --ft-titlebar-bg: rgb(62, 62, 62);
    --ft-titlebar-hover: rgb(71, 71, 71);
    --ft-surface: rgba(0, 0, 0, 0.14);
    --ft-surface-alt: rgba(255, 255, 255, 0.03);
    --ft-border: rgba(255, 255, 255, 0.08);
}

.ft-light {
    --ft-text: rgb(9, 9, 9);
    --ft-ok: rgb(41, 140, 56);
    --ft-ok-bg: rgba(41, 140, 56, 0.13);
    --ft-warning: rgb(191, 115, 0);
    --ft-warning-bg: rgba(191, 115, 0, 0.12);
    --ft-error: rgb(191, 38, 31);
    --ft-error-bg: rgba(191, 38, 31, 0.11);
    --ft-info: rgb(31, 102, 191);
    --ft-info-bg: rgba(31, 102, 191, 0.11);
    --ft-muted: rgb(102, 102, 102);
    --ft-muted-bg: rgba(0, 0, 0, 0.06);
    --ft-primary: rgb(0, 78, 149);
    --ft-primary-hover: rgb(0, 96, 176);
    --ft-titlebar-bg: rgb(203, 203, 203);
    --ft-titlebar-hover: rgb(214, 214, 214);
    --ft-surface: rgba(255, 255, 255, 0.45);
    --ft-surface-alt: rgba(0, 0, 0, 0.03);
    --ft-border: rgba(0, 0, 0, 0.12);
}

.ft-muted {
    color: var(--ft-muted);
}

/* Title bar overlay. Pawlygon Cyan rgb(0, 187, 213) and Blue rgb(0, 78, 149) come from the Pawlygon.net design tokens. */

.ft-titlebar {
    height: 0;
}

.ft-titlebar__area {
    position: absolute;
    top: -21px;
    left: 0;
    right: 0;
    height: 20px;
}

.ft-titlebar__row {
    flex-direction: row;
    align-items: center;
    height: 20px;
    margin-left: 18px;
    margin-right: 60px;
    background-color: var(--ft-titlebar-bg);
}

.ft-titlebar__row--hover {
    background-color: var(--ft-titlebar-hover);
}

/* Flat on the left, pointed on the right; FTTitleBar draws the background.
   The right padding is the point (7px) plus 2px. */
.ft-tag {
    flex-direction: row;
    align-items: center;
    height: 20px;
    padding: 0 9px 0 5px;
    margin-right: 2px;
    flex-shrink: 0;
}

.ft-tag__text {
    margin: 0;
    padding: 0;
    -unity-font-style: bold;
    color: rgb(13, 47, 51);
}

.ft-titlebar__title {
    flex-grow: 1;
    padding-left: 3px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.ft-titlebar__fallback {
    -unity-font-style: bold;
    margin: 8px 0 4px 3px;
}

/* Intro */

.ft-intro {
    flex-direction: row;
    align-items: center;
    padding: 2px 3px 2px 3px;
    margin-bottom: 4px;
}

.ft-intro__text {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
}

.ft-intro__help {
    width: 18px;
    height: 18px;
    margin: 0 0 0 4px;
    padding: 0;
    flex-shrink: 0;
    border-radius: 9px;
    -unity-font-style: bold;
}

.ft-details {
    font-size: 11px;
    white-space: normal;
    padding: 4px 6px 6px 6px;
    border-radius: 4px;
    background-color: var(--ft-surface);
    margin-top: 0;
    margin-bottom: 6px;
    color: var(--ft-muted);
}

/* Issues */

.ft-issue {
    flex-direction: row;
    align-items: center;
    padding: 3px 6px;
    margin-bottom: 3px;
    border-radius: 3px;
    border-left-width: 3px;
}

.ft-issue--error {
    border-left-color: var(--ft-error);
    background-color: var(--ft-error-bg);
}

.ft-issue--warning {
    border-left-color: var(--ft-warning);
    background-color: var(--ft-warning-bg);
}

.ft-issue--info {
    border-left-color: var(--ft-info);
    background-color: var(--ft-info-bg);
}

.ft-issue--ok {
    border-left-color: var(--ft-ok);
    background-color: var(--ft-ok-bg);
}

/* Upgrade window */

.ft-window {
    padding: 8px;
}

/* A step that needs explaining: a heading, the explanation, and its buttons */

.ft-step {
    flex-direction: column;
    align-items: stretch;
    padding-top: 4px;
    padding-bottom: 6px;
}

.ft-step__title {
    flex-direction: row;
    align-items: center;
}

.ft-step__heading {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    -unity-font-style: bold;
}

/* In line with the heading's text, past its icon */
.ft-step__body {
    margin-left: 22px;
}

.ft-step__text {
    margin-top: 2px;
    font-size: 11px;
    white-space: normal;
}

.ft-step__ranges {
    margin-top: 4px;
}

.ft-step__range {
    flex-direction: row;
}

.ft-step__range-label {
    width: 190px;
    flex-shrink: 1;
    font-size: 11px;
    color: var(--ft-muted);
}

.ft-step__range-value {
    font-size: 11px;
}

.ft-step__range-value--strong {
    -unity-font-style: bold;
}

.ft-step__buttons {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
}

.ft-step__button {
    height: 20px;
    margin: 0 4px 2px 0;
}

.ft-step__note {
    margin-top: 4px;
    font-size: 11px;
    white-space: normal;
    color: var(--ft-muted);
}

/* The action a step recommends */
.ft-button--primary {
    background-color: var(--ft-primary);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.ft-button--primary:hover {
    background-color: var(--ft-primary-hover);
}

.ft-issue__icon {
    width: 16px;
    height: 16px;
    margin-right: 6px;
    flex-shrink: 0;
}

.ft-issue__text {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
}

.ft-issue__button {
    height: 18px;
    margin: 0 0 0 4px;
    padding: 0 6px;
    flex-shrink: 0;
}

/* Cards */

.ft-card {
    padding: 5px 8px 7px 8px;
    margin-bottom: 6px;
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--ft-border);
    background-color: var(--ft-surface);
}

.ft-card__header {
    flex-direction: row;
    align-items: center;
    min-height: 20px;
    margin-bottom: 3px;
}

.ft-card__title {
    -unity-font-style: bold;
    flex-grow: 1;
}

.ft-card__extras {
    flex-direction: row;
    align-items: center;
}

/* Badges, chips and rows */

.ft-badge {
    padding: 1px 6px;
    margin-left: 4px;
    border-radius: 8px;
    font-size: 10px;
    -unity-font-style: bold;
}

.ft-badge--ok { color: var(--ft-ok); background-color: var(--ft-ok-bg); }
.ft-badge--warning { color: var(--ft-warning); background-color: var(--ft-warning-bg); }
.ft-badge--error { color: var(--ft-error); background-color: var(--ft-error-bg); }
.ft-badge--info { color: var(--ft-info); background-color: var(--ft-info-bg); }
.ft-badge--muted { color: var(--ft-muted); background-color: var(--ft-muted-bg); }

.ft-chips {
    flex-direction: row;
    flex-wrap: wrap;
}

.ft-chip {
    padding: 1px 6px;
    margin: 0 4px 4px 0;
    border-radius: 3px;
    font-size: 11px;
    background-color: var(--ft-muted-bg);
}

.ft-chip--clickable:hover {
    background-color: var(--ft-info-bg);
    color: var(--ft-info);
}

.ft-row {
    flex-direction: row;
    align-items: center;
    min-height: 18px;
}

.ft-row__label {
    width: 120px;
    flex-shrink: 0;
    color: var(--ft-muted);
}

.ft-row__value {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
}

.ft-field-row {
    flex-direction: row;
    align-items: center;
}

.ft-field-row > .unity-property-field {
    flex-grow: 1;
    flex-shrink: 1;
}

.ft-result {
    min-width: 110px;
    margin-left: 6px;
    font-size: 11px;
    -unity-text-align: middle-right;
    color: var(--ft-muted);
}

/* Eye rotation: where the range comes from, then hold an arrow to turn the eyes */

.ft-eye-detail {
    flex-direction: row;
    align-items: center;
    margin: 0 0 4px 3px;
}

.ft-eye-detail__note {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 11px;
    white-space: normal;
}

.ft-eye-preview {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.ft-eye-preview__label {
    font-size: 11px;
    color: var(--ft-muted);
    margin-right: 4px;
}

.ft-eye-preview__button {
    width: 24px;
    height: 18px;
    margin: 0 0 0 2px;
    padding: 0;
}

/* A field that only applies with the one above it */

.ft-sub-field {
    margin-left: 12px;
}

.ft-progress {
    height: 4px;
    margin: 2px 0 4px 0;
    border-radius: 2px;
    background-color: var(--ft-muted-bg);
}

.ft-progress__fill {
    height: 100%;
    border-radius: 2px;
}

.ft-progress__fill--ok { background-color: var(--ft-ok); }
.ft-progress__fill--warning { background-color: var(--ft-warning); }

/* Segmented control */

.ft-segmented {
    flex-direction: row;
    margin: 1px 3px 3px 3px;
}

.ft-segmented__button {
    flex-grow: 1;
    height: 20px;
    margin: 0;
    border-radius: 0;
}

.ft-segmented__button--first {
    border-top-left-radius: 3px;
    border-bottom-left-radius: 3px;
}

.ft-segmented__button--last {
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
}

.ft-segmented__button--selected {
    background-color: var(--ft-primary);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

/* Parameter table */

.ft-search {
    margin: 0 0 4px 0;
}

.ft-group-title {
    font-size: 11px;
    -unity-font-style: bold;
    margin: 4px 0 2px 2px;
    color: var(--ft-muted);
}

.ft-param {
    flex-direction: row;
    align-items: center;
    padding: 2px 4px;
    border-radius: 3px;
}

.ft-param--alt {
    background-color: var(--ft-surface-alt);
}

.ft-param__text {
    flex-grow: 1;
    flex-shrink: 1;
}

.ft-param__name {
    flex-direction: row;
    flex-wrap: wrap;
}

.ft-param__prefix {
    color: var(--ft-muted);
}

.ft-param__base {
    -unity-font-style: bold;
}

.ft-param__expression {
    font-size: 11px;
    white-space: normal;
    color: var(--ft-muted);
}

.ft-param__action {
    opacity: 0;
    height: 18px;
    margin: 0 0 0 4px;
    padding: 0 6px;
    flex-shrink: 0;
}

.ft-param:hover > .ft-param__action {
    opacity: 1;
}

.ft-toggle {
    margin: 0 4px 0 0;
}

/* Checklist rows */

.ft-card__note {
    font-size: 11px;
    margin: 0 0 4px 2px;
    white-space: normal;
}

/* A rule: its toggle and label, then its amount */

.ft-rule {
    flex-direction: row;
    align-items: center;
    min-height: 20px;
}

.ft-rule > .unity-toggle {
    width: 190px;
    flex-shrink: 0;
    margin: 0 4px 0 0;
}

.ft-rule > .unity-slider {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0;
}

.ft-check {
    flex-direction: row;
    align-items: center;
    padding: 2px 4px;
    border-radius: 3px;
}

.ft-check:hover {
    background-color: var(--ft-surface-alt);
}

.ft-check__toggle {
    margin: 0 6px 0 0;
    flex-shrink: 0;
}

.ft-check__text {
    flex-grow: 1;
    flex-shrink: 1;
}

/* Manual parameters */

.ft-manual {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.ft-manual__name {
    width: 38%;
    margin: 0;
}

.ft-manual__equals {
    margin: 0 4px;
    color: var(--ft-muted);
}

.ft-manual__expression {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0;
}

.ft-manual__state {
    width: 16px;
    height: 16px;
    margin-left: 4px;
    flex-shrink: 0;
}

.ft-manual__button {
    width: 20px;
    height: 18px;
    margin: 0 0 0 2px;
    padding: 0;
    flex-shrink: 0;
}

.ft-add-button {
    height: 20px;
    margin: 4px 0 0 0;
}

/* Tracking keys: search and filter, then one row per key */

.ft-key-tools {
    flex-direction: row;
    align-items: center;
    margin: 2px 0 4px 0;
}

.ft-key-tools__search {
    flex-grow: 1;
    flex-shrink: 1;
    width: auto;
    min-width: 40px;
    margin: 0 4px 0 0;
}

.ft-key-tools__filter {
    flex-shrink: 0;
    margin: 0;
}

.ft-key-tools__filter > .ft-segmented__button {
    flex-grow: 0;
    padding: 0 6px;
}

/* A problem's icon next to its setting */

.ft-mark {
    width: 14px;
    height: 14px;
    margin-left: 4px;
    flex-shrink: 0;
}

/* The face regions: a filter on top of the table */

.ft-key-regions {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 2px 0 0 0;
}

/* Wraps onto a second line in a narrow Inspector */
.ft-key-region {
    flex-grow: 1;
    height: 18px;
    margin: 0;
    padding: 0 3px;
    border-width: 0;
    border-bottom-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    font-size: 11px;
    color: var(--ft-muted);
}

.ft-key-region:hover {
    background-color: var(--ft-surface-alt);
}

.ft-key-region--selected {
    border-bottom-color: rgb(0, 187, 213);
    color: var(--ft-text);
    -unity-font-style: bold;
}

.ft-table__header {
    flex-direction: row;
    align-items: center;
    height: 20px;
    padding: 0 16px 0 4px;
    border-bottom-width: 1px;
    border-color: var(--ft-border);
}

.ft-table__header > .unity-label {
    margin: 0;
    padding: 0;
    -unity-font-style: bold;
}

.ft-table__grow {
    margin-left: 6px;
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.ft-table__last {
    width: 70px;
    flex-shrink: 0;
}

.ft-table__scroll {
    max-height: 320px;
    margin-bottom: 2px;
}

.ft-key-group {
    flex-direction: row;
    align-items: center;
    height: 18px;
    padding: 0 4px;
    background-color: var(--ft-muted-bg);
}

.ft-key-group__name {
    flex-grow: 1;
    margin: 0;
    padding: 0;
    font-size: 11px;
    -unity-font-style: bold;
}

.ft-key-group__count {
    margin: 0;
    padding: 0;
    font-size: 11px;
    color: var(--ft-muted);
}

.ft-key {
    flex-direction: row;
    align-items: center;
    min-height: 20px;
    padding: 1px 2px 1px 4px;
}

.ft-key--alt {
    background-color: var(--ft-surface-alt);
}

.ft-key:hover {
    background-color: var(--ft-surface-alt);
}

.ft-key__name {
    width: 42%;
    flex-shrink: 0;
    overflow: hidden;
}

.ft-key__value {
    flex-grow: 1;
    flex-shrink: 1;
    height: 18px;
    margin: 0;
    padding: 0 16px 0 6px;
    -unity-text-align: middle-left;
    overflow: hidden;
}

/* The same arrow Unity's own dropdowns have: the blendshape is picked from a list */
.ft-key__arrow {
    position: absolute;
    right: 2px;
    top: 2px;
    width: 14px;
    height: 14px;
}

/* What drives a row that isn't a single key. At least as wide as the key column, wider when its text needs it. */
.ft-key__driver {
    min-width: 54%;
    flex-shrink: 0;
}

/* A blendshape that's shown but not picked, like a tongue morph's */
.ft-key__plain {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0;
    padding: 0 6px;
    overflow: hidden;
}

.ft-key__plain--skipped {
    color: var(--ft-muted);
    -unity-font-style: italic;
}

.ft-key__value--unmapped {
    color: var(--ft-muted);
    -unity-font-style: italic;
}

.ft-key__value--edited {
    color: var(--ft-info);
    -unity-font-style: bold;
}

.ft-key__multiplier {
    width: 44px;
    height: 18px;
    margin: 0 0 0 4px;
    flex-shrink: 0;
}

.ft-key__multiplier > .unity-base-field__input {
    color: var(--ft-muted);
    -unity-text-align: middle-right;
}

.ft-key__multiplier--edited > .unity-base-field__input {
    color: var(--ft-info);
    -unity-font-style: bold;
}

.ft-key-bulk {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    margin: 0 0 2px 0;
}

.ft-key-bulk__label {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 11px;
    white-space: normal;
    -unity-text-align: middle-right;
}

.ft-key-bulk__button {
    height: 18px;
    margin: 0 0 0 4px;
    padding: 0 8px;
    flex-shrink: 0;
}

.ft-key__suggestion {
    height: 18px;
    margin: 0 0 0 4px;
    padding: 0 6px;
    flex-shrink: 1;
    font-size: 11px;
    color: var(--ft-warning);
    background-color: var(--ft-warning-bg);
    border-width: 0;
}

.ft-key__note {
    margin: 0 0 0 4px;
    padding: 0 6px;
    flex-shrink: 1;
    font-size: 11px;
    color: var(--ft-muted);
    -unity-text-align: middle-left;
    overflow: hidden;
}

.ft-key__reset {
    width: 20px;
    height: 18px;
    margin: 0 0 0 2px;
    padding: 0;
    flex-shrink: 0;
}
